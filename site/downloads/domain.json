    {"name": "adapter", "label": "Блок питания в комплекте", "type": "select", "choices": ["Да", "Нет"]}
  ],
  "rules": [
    {"when": {"field": "service", "equals": "Диагностика питания"}, "require": "adapter", "message": "Для диагностики питания укажите, передан ли блок питания."}
  ]
}
